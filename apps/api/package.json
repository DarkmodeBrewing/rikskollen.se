{
  "name": "@rikskollen/api",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --dts --minify --clean",
    "start": "node dist/index.js",
    "test": "node --import tsx --test --test-concurrency=1 src/*.test.ts"
  },
  "dependencies": {
    "@rikskollen/db": "workspace:*",
    "@rikskollen/shared-types": "workspace:*",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.6.2",
    "fastify-type-provider-zod": "^6.1.0",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "tsup": "^8.5.0"
  }
}
