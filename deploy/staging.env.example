# Copy to deploy/staging.env (ignored by git), then set a random hex password.
POSTGRES_PASSWORD=
WEB_PORT=4080
# The runbook exports GIT_SHA and IMAGE_TAG from the checked-out commit.

# Hostnames only, without scheme or port. Add the actual WireGuard IP if used for smoke checks.
NG_ALLOWED_HOSTS=localhost,127.0.0.1,rikskollen.se
