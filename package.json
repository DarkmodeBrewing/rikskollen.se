{
  "name": "rikskollen.se",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "pnpm -r dev",
    "dev:web": "pnpm --filter @rikskollen.se/website dev",
    "dev:api": "pnpm --filter @rikskollen.se/api dev",
    "dev:db": "pnpm --filter @rikskollen.se/db dev",
    "sync:worker": "pnpm --filter @rikskollen.se/worker sync",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  },
  "packageManager": "pnpm@9.0.0",
  "dependencies": {
    "@types/node": "^24.10.0",
    "dotenv": "^17.2.3",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
