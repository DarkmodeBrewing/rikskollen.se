{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*", "../../packages/shared-types/src/env.ts"],
  "exclude": ["dist"],
  "references": [
    { "path": "../../packages/db" },
    { "path": "../../packages/shared-types" }
  ]
}
