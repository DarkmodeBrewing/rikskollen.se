{
  "name": "@rikskollen/db",
  "version": "1.0.0",
  "private": true,
  "files": ["dist", "migrations"],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/migrate.ts --format esm --dts --clean --target node20",
    "migrate:run": "node dist/migrate.js",
    "migrate": "drizzle-kit migrate",
    "generate": "drizzle-kit generate",
    "test": "node --import tsx --test src/mapping/*.test.ts"
  },
  "dependencies": {
    "@rikskollen/shared-types": "workspace:*",
    "@types/pg": "^8.15.6",
    "drizzle-orm": "^0.44.7",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "tsx": "^4.20.6"
  }
}
