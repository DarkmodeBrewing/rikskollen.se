{
  "name": "rikskollen",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "pnpm -r dev",
    "dev:web": "pnpm --filter @rikskollen/webapp start",
    "dev:api": "pnpm --filter @rikskollen/api dev",
    "dev:db": "pnpm --filter @rikskollen/db dev",
    "build": "pnpm -r build",
    "build:db": "pnpm --filter @rikskollen/db build",
    "sync:worker": "pnpm --filter @rikskollen/worker sync",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  },
  "packageManager": "pnpm@9.0.0",
  "dependencies": {
    "@types/node": "^24.10.0",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.6",
    "drizzle-orm": "^0.44.7",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "zod": "^4.1.12"
  }
}
