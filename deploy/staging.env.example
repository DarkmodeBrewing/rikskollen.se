# Copy to deploy/staging.env (ignored by git), then set a random hex password.
POSTGRES_PASSWORD=
WEB_PORT=4080
# The runbook exports GIT_SHA and IMAGE_TAG from the checked-out commit.

# Hostnames only, without scheme or port. Add the actual WireGuard IP if used for smoke checks.
NG_ALLOWED_HOSTS=localhost,127.0.0.1,rikskollen.se

# Opt-in monitoring profile. Generic JSON receiver; keep its URL secret.
# Internal default checks the web -> API -> database path. Use the public URL
# to also check your external HTTPS route from this container.
MONITOR_BASE_URL=http://web:4000
MONITOR_WEBHOOK_URL=
MONITOR_TICK_SECONDS=300
MONITOR_DAILY_HOURS=26
MONITOR_BATCH_HOURS=3
MONITOR_RUNNING_MINUTES=45
