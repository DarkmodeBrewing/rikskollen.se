{
  "name": "rikskollen",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "pnpm --parallel -r --if-present dev",
    "dev:web": "pnpm --filter @rikskollen/webapp start",
    "dev:api": "pnpm --filter @rikskollen/api dev",
    "build": "pnpm -r build",
    "build:db": "pnpm --filter @rikskollen/db build",
    "test": "pnpm --filter @rikskollen/db test && pnpm --filter @rikskollen/worker test && pnpm --filter @rikskollen/api test"
  },
  "packageManager": "pnpm@9.0.0",
  "dependencies": {
    "@types/node": "^24.10.0",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.6",
    "drizzle-orm": "^0.44.7",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "zod": "^4.1.12"
  }
}
