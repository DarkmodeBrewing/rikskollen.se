{
  "name": "@rikskollen/worker",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "start": "node ./dist/index.js",
    "build": "tsup src/index.ts src/sync-persons.ts --format esm --clean --target node20",
    "sync:persons": "node dist/sync-persons.js",
    "test": "node --import tsx --test src/clients/*.test.ts src/*.test.ts",
    "dry:vote-cases": "tsx src/index.ts"
  },
  "dependencies": {
    "@rikskollen/db": "workspace:*",
    "@rikskollen/shared-types": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.0"
  }
}
